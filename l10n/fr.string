# General ellipsis or placeholder text
"..." = "..."

# Name of the plugin or UI title
"Carrier Parking Finder" = "Recherche de Parking de Transporteur"

# Result format showing carrier name, distance, and available slots
"Found: {name} ({dist:.1f} ly) - Slots: {slots}" = "Trouvé : {name} ({dist:.1f} al) - Places : {slots}"

# Error message when no valid parking location is found in range
"No suitable parking system found within range." = "Aucun système de parking adapté trouvé à portée."

# Button or action label to trigger a search
"Search" = "Rechercher"

# Status message shown while querying around a specific star system
"Searching around {system}..." = "Recherche autour de {system}..."

# Log message when the plugin initializes
"Starting EDR Parking Finder plugin." = "Démarrage du plugin EDR Recherche de Parking."

# Label for star system input or display
"System:" = "Système :"

# Status message while waiting for client/journal updates
"Waiting for game data..." = "En attente des données du jeu..."
