# General ellipsis or placeholder text
"..." = "..."

# Name of the plugin or UI title
"Carrier Parking Finder" = "Procura de Estacionamento de Porta-Naves"

# Result format showing carrier name, distance, and available slots
"Found: {name} ({dist:.1f} ly) - Slots: {slots}" = "Encontrado: {name} ({dist:.1f} al) - Lugares: {slots}"

# Error message when no valid parking location is found in range
"No suitable parking system found within range." = "Nenhum sistema de estacionamento adequado encontrado no alcance."

# Button or action label to trigger a search
"Search" = "Procurar"

# Status message shown while querying around a specific star system
"Searching around {system}..." = "A pesquisar em redor de {system}..."

# Log message when the plugin initializes
"Starting EDR Parking Finder plugin." = "A iniciar o plugin EDR Procura de Estacionamento."

# Label for star system input or display
"System:" = "Sistema:"

# Status message while waiting for client/journal updates
"Waiting for game data..." = "A aguardar dados do jogo..."
