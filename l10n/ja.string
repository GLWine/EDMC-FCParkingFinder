# General ellipsis or placeholder text
"..." = "..."

# Name of the plugin or UI title
"Carrier Parking Finder" = "キャリア駐車場ファインダー"

# Result format showing carrier name, distance, and available slots
"Found: {name} ({dist:.1f} ly) - Slots: {slots}" = "発見: {name} ({dist:.1f} ly) - 空き: {slots}"

# Error message when no valid parking location is found in range
"No suitable parking system found within range." = "範囲内に適切な駐車可能システムが見つかりません。"

# Button or action label to trigger a search
"Search" = "検索"

# Status message shown while querying around a specific star system
"Searching around {system}..." = "{system} の周辺を検索中..."

# Log message when the plugin initializes
"Starting EDR Parking Finder plugin." = "EDR Parking Finder プラグインを開始しています。"

# Label for star system input or display
"System:" = "システム:"

# Status message while waiting for client/journal updates
"Waiting for game data..." = "ゲームデータを待っています..."
